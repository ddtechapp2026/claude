# systemd unit for the trading bot.
# Install:  sudo cp deploy/stonks-bot.service /etc/systemd/system/
# Then:     sudo systemctl daemon-reload && sudo systemctl enable --now stonks-bot
#
# Adjust User and paths if you did not follow docs/ORACLE_SETUP.md exactly.
[Unit]
Description=Stonks crypto trading bot
After=network-online.target
Wants=network-online.target
# Crash-loop backoff lives in [Unit] on this systemd version.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Stonks
# Use the virtualenv's python so dependencies are found.
ExecStart=/home/ubuntu/Stonks/.venv/bin/python -m src.engine
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
