# =============================================================================
# Stonks configuration - copy this file to ".env" and fill in your values.
#   cp .env.example .env
# The .env file is git-ignored so your keys are never committed.
# =============================================================================

# --- AI (OpenRouter) ---------------------------------------------------------
# The AI features (plain-English strategies + learning from mistakes) call
# OpenRouter. Get a key at https://openrouter.ai/keys and paste it here.
# Without a key everything still works using a built-in rule-based parser.
OPENROUTER_API_KEY=your_openrouter_key_here

# Keep the AI 100% free: when true, only OpenRouter FREE models (":free" slugs)
# are ever called. If the chosen free model is unavailable the app falls back to
# the built-in rule-based parser rather than spending money — so no paid usage.
OPENROUTER_FREE_ONLY=true

# Model slug. With FREE_ONLY on, ":free" is added automatically if you omit it.
# Browse current free models at https://openrouter.ai/models?max_price=0
# (free models have daily rate limits, which is fine for this app).
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Market data (Alpaca) ----------------------------------------------------
# The bots trade SIMULATED wallets priced off real Alpaca crypto data. That
# data works WITHOUT keys; adding paper keys just raises your rate limits.
# Get them from https://app.alpaca.markets/ -> Paper Trading -> API Keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Engine ------------------------------------------------------------------
# Default symbol for newly seeded bots (each bot can be changed individually).
TRADE_SYMBOL=BTC/USD

# The cryptos a bot may trade. Set any bot's symbol to "AUTO" and it will scan
# this whole list each cycle and buy whichever one its strategy fires on.
CRYPTO_UNIVERSE=BTC/USD,ETH/USD,SOL/USD,LTC/USD,DOGE/USD,AVAX/USD,LINK/USD,BCH/USD,UNI/USD,DOT/USD

# How often the engine checks the market for every enabled bot, in seconds.
POLL_INTERVAL_SECONDS=60

# Bar size + how much history to pull for indicators.
# BAR_TIMEFRAME options: 1Min, 5Min, 15Min, 1Hour, 1Day
BAR_TIMEFRAME=15Min
LOOKBACK_HOURS=72

# --- Costs (defaults for new bots; each bot is editable on the dashboard) -----
# Trading fee charged on every buy AND sell, as a fraction (0.001 = 0.1%).
FEE_PCT=0.001
# Estimated tax applied to net realized GAINS, as a fraction (0.30 = 30%).
# This is only an estimate for the P&L breakdown, not tax advice.
TAX_PCT=0.30

# --- Learning loop -----------------------------------------------------------
# A bot is reviewed every N closed trades; changes auto-apply within guardrails.
AI_REVIEW_MIN_TRADES=5
# Reviews tighten risk when the recent win-rate falls below this (0.45 = 45%).
AI_MIN_WINRATE=0.45

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=data/stonks.db

# --- Dashboard ---------------------------------------------------------------
# 127.0.0.1 = localhost only, correct when nginx sits in front (see deploy/).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
