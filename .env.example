# =============================================================================
# Stonks configuration - copy this file to ".env" and fill in your values.
#   cp .env.example .env
# The .env file is git-ignored so your keys are never committed.
# =============================================================================

# --- Alpaca API credentials --------------------------------------------------
# Get these from https://app.alpaca.markets/  ->  "Paper Trading" ->  API Keys.
# Make sure you generate PAPER keys (not live) while testing.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Keep this "true" for paper trading. Only set to "false" once you have live
# keys AND you understand you are trading real money.
ALPACA_PAPER=true

# --- Bot behaviour -----------------------------------------------------------
# Crypto symbol to trade, Alpaca format (e.g. BTC/USD, ETH/USD).
TRADE_SYMBOL=BTC/USD

# How often the bot wakes up to check the market, in seconds.
POLL_INTERVAL_SECONDS=60

# Dollar amount to buy per entry signal (notional order). Paper money.
ORDER_NOTIONAL_USD=100

# Bar size + how much history to pull for your indicators.
# BAR_TIMEFRAME options: 1Min, 5Min, 15Min, 1Hour, 1Day
BAR_TIMEFRAME=15Min
LOOKBACK_HOURS=48

# Safety switch: when "true" the bot logs the trade it WOULD make but does not
# send any order. Great for a first dry run even against the paper account.
DRY_RUN=false

# --- Storage -----------------------------------------------------------------
# SQLite database file shared by the bot and the dashboard.
DATABASE_PATH=data/stonks.db

# --- Dashboard ---------------------------------------------------------------
# Address/port the dashboard binds to. 127.0.0.1 means "localhost only" which
# is correct when nginx sits in front of it (see deploy/). Use 0.0.0.0 only if
# you intentionally want to expose it without a reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
